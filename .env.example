# Supabase project (the same project Vachi uses is fine: this app keeps its tables in its own "rentals" schema)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: creating tenant invite and password-reset links
SUPABASE_SERVICE_ROLE_KEY=
# Server only: Drizzle's direct Postgres connection
DATABASE_URL=
# This app's own address, e.g. https://rentals.example.com; invite links come back here
NEXT_PUBLIC_APP_URL=
# The app's own emails (tenant invites, password resets). A Gmail account with an App Password works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Daily rent reminders (vercel.json cron). Any long random string; Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Online rent payments (optional; off until set). From the Stripe dashboard, with Connect turned on.
# Add both as Vercel "Sensitive" variables, never in code or chat.
STRIPE_SECRET_KEY=
# Signing secret of a Connect webhook pointed at /api/stripe/webhook, listening for
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired and account.updated.
STRIPE_WEBHOOK_SECRET=
