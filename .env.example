# Supabase project (the same project Vachi uses is fine: this app keeps its tables in its own "rentals" schema)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: creating tenant invite and password-reset links
SUPABASE_SERVICE_ROLE_KEY=
# Server only: Drizzle's direct Postgres connection
DATABASE_URL=
# This app's own address, e.g. https://rentals.example.com; invite links come back here
NEXT_PUBLIC_APP_URL=
# The app's own emails (tenant invites, password resets). A Gmail account with an App Password works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
